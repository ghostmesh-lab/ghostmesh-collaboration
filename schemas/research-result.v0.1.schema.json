{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GhostMesh Lab offline research result draft v0.1",
  "description": "Structural integrity only. This schema does not authenticate researchers, methods or results.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "case_id",
    "source_revision",
    "fixture_sha256",
    "participant",
    "method",
    "started_at",
    "claims",
    "evidence",
    "privacy",
    "external_authority",
    "human_review",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "ghostmesh.research-result/v0.1"
    },
    "status": {
      "enum": [
        "EXAMPLE_NOT_RUN",
        "AUTHOR_REPORTED",
        "INDEPENDENTLY_REPRODUCED"
      ]
    },
    "case_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "source_revision": {
      "type": "string",
      "minLength": 7,
      "maxLength": 128
    },
    "fixture_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_identity",
        "actor_type",
        "sponsor",
        "identity_assurance"
      ],
      "properties": {
        "declared_identity": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "actor_type": {
          "enum": [
            "HUMAN",
            "AGENT",
            "ORGANIZATION",
            "REFERENCE_TOOL"
          ]
        },
        "sponsor": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "identity_assurance": {
          "enum": [
            "SELF_DECLARED",
            "ATTESTED_BY_INDEPENDENT_REVIEWER",
            "UNKNOWN"
          ]
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "tool_and_version",
        "independent_from_fixture_author",
        "public_procedure"
      ],
      "properties": {
        "type": {
          "enum": [
            "DETERMINISTIC_REFERENCE",
            "HUMAN",
            "MODEL_ASSISTED",
            "OTHER"
          ]
        },
        "tool_and_version": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180
        },
        "independent_from_fixture_author": {
          "type": "boolean"
        },
        "public_procedure": {
          "type": "string",
          "minLength": 8,
          "maxLength": 800
        }
      }
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "verdict",
          "basis"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100
          },
          "verdict": {
            "enum": [
              "SUPPORTED",
              "REFUTED",
              "DISPUTED",
              "UNKNOWN",
              "NOT_EVALUATED"
            ]
          },
          "basis": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            },
            "maxItems": 15
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "privacy": {
      "const": "PUBLIC_SYNTHETIC_ONLY"
    },
    "external_authority": {
      "const": "NONE"
    },
    "human_review": {
      "enum": [
        "PENDING",
        "REVIEWED",
        "REJECTED"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "string",
        "minLength": 7
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "INDEPENDENTLY_REPRODUCED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "method": {
            "properties": {
              "independent_from_fixture_author": {
                "const": true
              }
            }
          },
          "started_at": {
            "type": "string"
          },
          "evidence": {
            "minItems": 1
          },
          "human_review": {
            "const": "REVIEWED"
          },
          "claims": {
            "items": {
              "properties": {
                "verdict": {
                  "not": {
                    "const": "NOT_EVALUATED"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "EXAMPLE_NOT_RUN"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "started_at": {
            "type": "null"
          },
          "human_review": {
            "const": "PENDING"
          },
          "evidence": {
            "maxItems": 0
          },
          "method": {
            "properties": {
              "independent_from_fixture_author": {
                "const": false
              }
            }
          },
          "claims": {
            "items": {
              "properties": {
                "verdict": {
                  "const": "NOT_EVALUATED"
                }
              }
            }
          }
        }
      }
    }
  ]
}
